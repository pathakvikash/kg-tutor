{
  "name": "kg-tutor",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @kg/db db:generate",
    "db:migrate": "pnpm --filter @kg/db db:migrate",
    "db:studio": "pnpm --filter @kg/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,prisma}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
