generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum TopicRelation {
  contains
  applied_in
}

enum EdgeType {
  prerequisite_of
  contains
  related_to
  applied_in
  extends
}

/// hard = target is not understandable without it; requires a failureMode
enum EdgeStrength {
  hard
  soft
}

/// Ordinal, never a float; LLM grading cannot justify finer precision
enum MasteryLevel {
  unknown
  familiar
  functional
  solid
}

enum EvidenceSource {
  self_reported
  assessed
  taught
  inferred
}

enum GoalDepth {
  use
  debug
  build
}

enum ResolverVerdict {
  same
  narrower
  broader
  related
  distinct
}

enum ProposalOutcome {
  created
  bound
}

enum ReviewStatus {
  open
  accepted
  rejected
}

enum ContentStatus {
  candidate
  canonical
  retired
}

model Topic {
  id          String   @id @default(uuid())
  name        String
  kind        String   @default("subject")
  description String   @db.Text
  isDagLike   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones  MilestoneTemplate[]
  goals       Goal[]
  concepts    TopicConcept[]

  @@unique([name])
}

model Concept {
  id            String   @id @default(uuid())
  canonicalName String

  /// Immutable after creation; identity depends on it, so deprecate instead of editing
  sense         String   @db.Text
  senseVector   Unsupported("vector(1536)")?

  description   String   @db.Text @default("")

  deprecatedAt  DateTime?
  supersededById String?
  supersededBy  Concept?  @relation("supersede", fields: [supersededById], references: [id])
  supersedes    Concept[] @relation("supersede")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases       ConceptAlias[]
  outgoing      Edge[] @relation("edgeSrc")
  incoming      Edge[] @relation("edgeDst")
  items         AssessmentItem[]
  content       ExplanationContent[]
  states        LearnerConceptState[]
  misconceptions Misconception[]
  evidence      EvidenceEvent[]
  planSteps     PlanStep[]
  milestoneReqs MilestoneConcept[]
  topics        TopicConcept[]

  @@index([canonicalName])
  @@index([deprecatedAt])
}

model TopicConcept {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  relation  TopicRelation @default(contains)
  direct    Boolean  @default(true)
  relevance Float    @default(0.5)
  createdAt DateTime @default(now())

  @@unique([topicId, conceptId, relation])
  @@index([conceptId])
}

model ConceptAlias {
  id        String   @id @default(uuid())
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([name])
  @@index([conceptId])
}

model Edge {
  id        String       @id @default(uuid())
  srcId     String
  src       Concept      @relation("edgeSrc", fields: [srcId], references: [id], onDelete: Cascade)
  dstId     String
  dst       Concept      @relation("edgeDst", fields: [dstId], references: [id], onDelete: Cascade)
  type      EdgeType
  strength  EdgeStrength @default(soft)

  /// Required on hard edges: the misunderstanding that occurs without the prerequisite
  failureMode String?    @db.Text

  confidence  Float      @default(0.5)
  provisional Boolean    @default(false)
  promotedById String?
  promotedBy  PromotionProposal? @relation(fields: [promotedById], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  retiredAt   DateTime?
  retiredReason String?

  @@unique([srcId, dstId, type])
  @@index([dstId, type, strength])
  @@index([srcId, type, strength])
}

model ConceptProposal {
  id            String           @id @default(uuid())
  proposedName  String
  proposedSense String           @db.Text
  context       String?          @db.Text
  expectedNeighborIds String[]   @default([])
  verdict       ResolverVerdict?
  outcome       ProposalOutcome?
  resolvedToId  String?
  candidates    Json?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([resolvedAt])
}

model MergeRecord {
  id            String   @id @default(uuid())
  winnerId      String
  loserId       String
  rewrittenEdges Json
  movedStates   Json
  reason        String   @db.Text
  reversedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([loserId])
}

model AssessmentItem {
  id         String        @id @default(uuid())
  conceptId  String
  concept    Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  version    Int           @default(1)
  prompt     String        @db.Text
  /// Code the question is about, kept out of `prompt` so its newlines survive markdown
  code       String?       @db.Text
  codeLanguage String?
  rubric     Json
  targetsLevel MasteryLevel @default(functional)
  requiresTransfer Boolean  @default(false)
  status     ContentStatus @default(candidate)

  timesUsed       Int   @default(0)
  correctCount    Int   @default(0)
  discrimination  Float @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  evidence   EvidenceEvent[]

  @@index([conceptId, status])
}

model ExplanationContent {
  id        String        @id @default(uuid())
  conceptId String
  concept   Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  version   Int           @default(1)
  status    ContentStatus @default(candidate)

  claims    String   @db.Text
  examples  Json     @default("[]")
  analogies Json     @default("[]")

  bucket    String?

  timesShown     Int   @default(0)
  followedByPass Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence  EvidenceEvent[]

  @@index([conceptId, status, bucket])
}

model Learner {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  background String? @db.Text
  workingLanguage String?
  orgId     String?
  createdAt DateTime @default(now())

  states         LearnerConceptState[]
  misconceptions Misconception[]
  evidence       EvidenceEvent[]
  goals          Goal[]
  plans          Plan[]
  sessions       Session[]

  @@index([orgId])
}

model LearnerConceptState {
  id        String       @id @default(uuid())
  learnerId String
  learner   Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  /// Highest level demonstrated; never demoted on a single failure
  mastery   MasteryLevel @default(unknown)
  confidence Float       @default(0)
  source    EvidenceSource @default(inferred)

  lastEvidenceAt DateTime?
  reprobeQueuedAt DateTime?
  blockedUntil    DateTime?

  updatedAt DateTime @updatedAt

  @@unique([learnerId, conceptId])
  @@index([learnerId, mastery])
  @@index([conceptId])
}

model Misconception {
  id        String   @id @default(uuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  belief    String   @db.Text
  matchedFailureMode String?
  observedCount Int   @default(1)
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([learnerId, conceptId])
  @@index([conceptId, resolvedAt])
}

enum EvidenceKind {
  restated
  applied
  transferred
  failed_check
  misconception_shown
  careless_error
  self_reported_skip
  spontaneous_prerequisite_request
  downstream_success
  reprobe_pass
  reprobe_fail
}

model EvidenceEvent {
  id        String       @id @default(uuid())
  learnerId String
  learner   Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?     @relation(fields: [sessionId], references: [id])

  kind      EvidenceKind
  itemId    String?
  item      AssessmentItem? @relation(fields: [itemId], references: [id])
  contentId String?
  content   ExplanationContent? @relation(fields: [contentId], references: [id])

  referencedConceptId String?
  response  String?      @db.Text
  detail    Json?

  createdAt DateTime     @default(now())

  @@index([conceptId, kind, createdAt])
  @@index([learnerId, createdAt])
  @@index([sessionId])
}

model PromotionProposal {
  id        String   @id @default(uuid())
  kind      String
  srcId     String?
  dstId     String?
  claim     String   @db.Text

  distinctLearners Int   @default(0)
  effectSize       Float @default(0)
  controlFailureRate Float?
  treatmentFailureRate Float?
  distinctGoals    Int   @default(0)

  evidencePacket Json
  status    ReviewStatus @default(open)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promotedEdges Edge[]

  @@index([status, effectSize])
}

model Goal {
  id        String    @id @default(uuid())
  learnerId String
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id])
  depth     GoalDepth @default(use)
  constraints Json?
  version   Int       @default(1)
  active    Boolean   @default(false)
  createdAt DateTime  @default(now())

  plans     Plan[]

  @@index([learnerId, active])
}

model MilestoneTemplate {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  claim     String
  ordering  Int      @default(0)
  status    ContentStatus @default(candidate)
  createdAt DateTime @default(now())

  concepts  MilestoneConcept[]
  instances MilestoneInstance[]

  @@index([topicId, ordering])
}

model MilestoneConcept {
  id          String       @id @default(uuid())
  templateId  String
  template    MilestoneTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  conceptId   String
  concept     Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  requiredLevel MasteryLevel @default(functional)

  @@unique([templateId, conceptId])
}

model Plan {
  id        String   @id @default(uuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  revisionReason String? @db.Text
  supersededAt DateTime?
  createdAt DateTime @default(now())

  steps      PlanStep[]
  milestones MilestoneInstance[]

  @@index([learnerId, supersededAt])
}

model PlanStep {
  id        String   @id @default(uuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  position  Int
  requiredLevel MasteryLevel @default(functional)
  committed Boolean  @default(false)
  unlockCount Int    @default(0)
  completedAt DateTime?

  @@unique([planId, position])
  @@index([conceptId])
}

model MilestoneInstance {
  id         String   @id @default(uuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  templateId String
  template   MilestoneTemplate @relation(fields: [templateId], references: [id])
  position   Int
  foldedForward Boolean @default(false)
  completedAt DateTime?

  @@unique([planId, position])
}

model Session {
  id        String   @id @default(uuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  variant   String   @default("graph")
  kind      String   @default("lesson")
  startedAt DateTime @default(now())
  endedAt   DateTime?

  evidence  EvidenceEvent[]
  decisions PlannerDecision[]
  turns     LessonTurn[]

  @@index([learnerId, startedAt])
  @@index([learnerId, kind, endedAt])
}

model UsageRecord {
  id            String   @id @default(uuid())
  sessionId     String?
  learnerId     String?
  purpose       String
  tier          String
  model         String
  promptTokens  Int      @default(0)
  outputTokens  Int      @default(0)
  costUsd       Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([purpose, createdAt])
  @@index([learnerId, createdAt])
  @@index([sessionId])
}

model IntakeSession {
  id         String   @id @default(uuid())
  learnerId  String
  topicId    String
  depth      String   @default("use")
  goalText   String?  @db.Text
  state      Json
  status     String   @default("asking")
  currentConceptId String?
  currentItemId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([learnerId, status])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LessonTurn {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String
  conceptId String?
  role      String
  text      String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([learnerId, createdAt])
}

model ExpansionJob {
  id          String    @id @default(uuid())
  topicName   String
  description String?
  status      String    @default("queued")
  phase       String    @default("starting")
  progress    Float     @default(0)
  report      Json?
  error       String?   @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model PlannerDecision {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidates Json
  selected  Json
  reasonCodes String[]
  stateSnapshot Json
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}
